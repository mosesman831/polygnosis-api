# OpenAI-compatible endpoint (Vercel AI Gateway, OpenAI, LexGateway, OpenRouter, etc.)
POLYGNOSIS_API_BASE_URL=https://ai-gateway.vercel.sh/v1
# Outbound gateway key (calls to the LLM provider)
POLYGNOSIS_API_KEY=sk-...

# Optional defaults — override per role in config.yaml
POLYGNOSIS_DEFAULT_MODEL=anthropic/claude-sonnet-4

# Boardroom config discovery: explicit path wins, then ./config.yaml, then packaged default
POLYGNOSIS_CONFIG_PATH=

# Inbound auth. Empty = allow all requests (local-dev; logs a loud warning).
# If set, /v1/* requires Authorization: Bearer <key> or X-API-Key: <key>.
POLYGNOSIS_SERVICE_API_KEY=

# Concurrency: max queued+running jobs before returning HTTP 429
POLYGNOSIS_MAX_IN_FLIGHT=2

# Durable job store (SQLite)
POLYGNOSIS_JOBS_DB=./data/jobs.db

# LLM retry attempts on timeout / connect error / HTTP 429,500,502,503
POLYGNOSIS_LLM_MAX_RETRIES=3

# Global cap on concurrent in-flight LLM completions
POLYGNOSIS_MAX_LLM_CONCURRENCY=8

# Per-role sampling. Solvers run hotter for diversity; scorer is deterministic.
# temperature_default / max_tokens_default apply to roles not listed.
POLYGNOSIS_TEMPERATURE_SOLVER=0.5
POLYGNOSIS_TEMPERATURE_CRITIC=0.2
POLYGNOSIS_TEMPERATURE_SCORER=0.0
POLYGNOSIS_TEMPERATURE_DEFAULT=0.3
POLYGNOSIS_MAX_TOKENS_SOLVER=8192
POLYGNOSIS_MAX_TOKENS_DEFAULT=4096

# Job lease TTL (seconds): running jobs with an expired lease are reclaimed
POLYGNOSIS_JOB_LEASE_SECONDS=3600

# Reflexion correction buffer (single-operator local use; not multi-tenant safe)
POLYGNOSIS_REFLEXION_ENABLED=false

# Max objective length; requests over this return HTTP 422
POLYGNOSIS_OBJECTIVE_MAX_CHARS=20000

# Job artifacts (written to disk; path stored on job row, omitted from HTTP response)
POLYGNOSIS_ARTIFACTS_DIR=./artifacts
POLYGNOSIS_CORRECTIONS_BUFFER=./.corrections_buffer.json

# Server
POLYGNOSIS_HOST=0.0.0.0
POLYGNOSIS_PORT=8080
